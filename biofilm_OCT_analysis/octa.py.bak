""" 
 ************************** 2D BINARY PROCEDURE **************************
 !!! All images in the folder have to be of the same dimensions and 
     resolutions.
 Taken directly from original Matlab project

 The code performs the following tasks:

 1) Apply thresholding to grayscale images
    Input: Names must be gs_##.tif
    Output: bw_##.tif

    Use marked images in given gsm subfolder: and with the name
    'gsm_*.tif'.
    
    Beware: 
    (1) Before marking the membranes (manually or in combination with the
    script membDetection2D.m) use the script 'img2tiff.m' on the original
    *.img files in order to create the gsm_*.tif files in the target subfolder
    (2) The marked membranes have to be black, i.e. of value 0.

 2) Cut membrane of binary images
    Input: bw_*.tif and gsm_*.tif (Output of 1 and the membrane_marked files)
    Output: bwc_*.tif

 3) Calculate the parameters (automatically) *** incl. outlier detection
    Input: bwc_*.tif (Output of 3)
    Ouptut: bwc_outl2_*.tif

 4) Completely remove the background from the original grayscale images
    for representation purposes and also create an image with equal pixel
    resolution in X- and Z-direction.
    Input: bw_*.tif and gs_*.tif (Ouput of 1 and original files)
    Output: bg_*.tif and bgEqualAxis_*.tif

 5) Generate Excel file summarizing the results
    Input: Results from step 3
    Output: Excel file with results
"""

import src.io_manager
import src.options
import src.util
import src.driver
from src.image_data import ImageData
import time

def main():

    option_setups = src.io_manager.validate_options()
    for option_setup, filename in option_setups:
        start_time = time.time()
        src.io_manager.reset_options(option_setup, filename) # stateful on options
        folder = src.options.get_folder('gs')
        data : list[ImageData] = []
        src.io_manager.read_prefix(folder, 'gs_', data, ImageData.gs.fset)
        gsm_folder = src.options.get_folder('gsm')
        src.io_manager.read_prefix(gsm_folder, 'gsm_', data, ImageData.gsm.fset)
        print((data))
        src.driver.write_cutoff(src.options.get('use_cutoff'),
            src.options.get('cutoff_sides'))
        src.driver.write_sizes(src.options.get('height'), 
            src.options.get('width')) # stateful
        if src.options.get('bw_folder') is False:
            src.driver.write_bw(data)
        src.driver.read_bw(data)
        if src.options.get('bwc_folder') is False:
            src.driver.write_bwc(data)
        src.driver.read_bwc(data)
        src.driver.calculate_outliers(data) # this looks out of order, but is not
        src.driver.oct_analysis(data)

        src.util.print_normal(f'{time.time()-start_time} seconds for calculation')

        src.util.print_normal('Data written successfully')

if __name__=='__main__':
    main()